# Copy to .env.local. Everything is optional in development.

# --- Engines (unset = public dev fallbacks; NEVER use the fallbacks in production) ---
# VALHALLA_URL=http://127.0.0.1:8002
# PHOTON_URL=http://127.0.0.1:2322
# VROOM_URL=http://127.0.0.1:3000
# PMTILES_PATH=data/tiles/region.pmtiles
# GLYPHS_URL=https://your-cdn.example.com/fonts/{fontstack}/{range}.pbf
# INDIA_BOUNDARY_GEOJSON=public/data/india-boundary.geojson
# Refuse to call public fallbacks (set this in production):
# REQUIRE_SELF_HOSTED=1

# --- Database (unset = SQLite at data/naksha.db) ---
# DATABASE_URL=postgres://naksha:change-me@127.0.0.1:5432/naksha
# SQLITE_PATH=data/naksha.db

# --- Secrets ---
# Used to derive the first-party map key. Generated into data/.secret if unset.
# NAKSHA_SECRET=at-least-32-random-characters
